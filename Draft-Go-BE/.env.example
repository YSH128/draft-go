# MySQL 설정
MYSQL_URL=jdbc:mysql://localhost:3306/draft_go_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# mongoDB 설정
MONGO_URI=mongodb://mongodb:27017/draft-go-db

#RIOT API 설정
RIOT_API_MODE=REAL
RIOT_API_KEY=your-riot-api-key-here

# JWT 설정
JWT_SECRET=your-secret-key-min-64-characters-long-for-security
JWT_ACCESS_TOKEN_VALIDITY_IN_SECONDS=1800
JWT_REFRESH_TOKEN_VALIDITY_IN_SECONDS=604800

# Spring 프로파일 설정
SPRING_PROFILES_ACTIVE=dev